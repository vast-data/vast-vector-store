# Copy this file to .env and fill in your values.
# .env is loaded automatically by pytest (via conftest.py) and by the example scripts.

# --- Required ---

# HTTP(S) endpoint of your VastDB cluster
VASTDB__ENDPOINT=https://<host>:<port>

# S3-compatible access credentials
VASTDB__ACCESS_KEY=<access-key>
VASTDB__SECRET_KEY=<secret-key>

# Bucket to use for the vector store
VASTDB__BUCKET=<bucket-name>

# --- Optional (ADBC fast-path for filtered search) ---
# Leave unset to fall back to the default query path.

# Internal cluster IP used by the ADBC Arrow Flight driver (often differs from VASTDB__ENDPOINT)
# VASTDB__ADBC_ENDPOINT=<internal-ip>

# Absolute path to the ADBC .so driver binary.
# Not available on macOS — on Linux CI it is downloaded and injected automatically.
# VASTDB__ADBC_DRIVER_PATH=/path/to/libvastdb_adbc.so
