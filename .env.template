# Copy this file to .env and fill in your values.
# .env is loaded automatically by pytest (via conftest.py) and by the example scripts.

# --- Required ---

# HTTP(S) endpoint of your VastDB cluster (read automatically by vastdb.connect)
AWS_S3_ENDPOINT_URL=https://<host>:<port>

# S3-compatible access credentials (read automatically by vastdb.connect)
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>

# Bucket to use for the vector store
VASTDB_BUCKET=<bucket-name>

# --- Optional (ADBC fast-path for filtered search) ---
# Leave unset to fall back to the default query path.

# Internal cluster IP used by the ADBC Arrow Flight driver (often differs from AWS_S3_ENDPOINT_URL)
# VASTDB_ADBC_ENDPOINT=<internal-ip>

# Absolute path to the ADBC .so driver binary.
# Not available on macOS — on Linux CI it is downloaded and injected automatically.
# VASTDB_ADBC_DRIVER_PATH=/path/to/libvastdb_adbc.so
